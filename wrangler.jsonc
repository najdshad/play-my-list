{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "play-my-list",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./miniapp",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/telegram/*", "/health"],
  },
  "durable_objects": {
    "bindings": [{ "name": "PLAYLISTS", "class_name": "PlaylistApp" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlaylistApp"] }],
  "vars": {
    "OWNER_ID": "1078676262",
    "PUBLISH_DELAY_SECONDS": "1.1",
    "SCAN_DELAY_SECONDS": "1",
  },
  "observability": { "enabled": true },
}
